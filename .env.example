# ============================================================
# JobFit Agent — environment template（Phase 6 环境契约，§6）
#
# 复制为 .env 后填写真实值。.env / .env.local 永不提交（见根 .gitignore）。
# 参考: docs/architecture.md §8 / ADR-013 / docs/release.md
#
# 最小可运行集合（本地一键启动）：
#   APP_ENV / DATABASE_URL / TEST_DATABASE_URL / STORAGE_DIR / CONFIG_DIR
# DEEPSEEK_API_KEY 为**可选**：未配置时 critique 落 `unavailable`
#   （EXTERNAL CREDENTIAL BLOCKED），确定性分析与报告照常可用。
# ============================================================

# ------------------------------------------------------------- 运行环境
# 取值: local | test | prod
APP_ENV=local

# ------------------------------------------------------------- PostgreSQL（pgvector）
# docker compose 的 db 服务使用以下三个变量初始化（不要与 DATABASE_URL 冲突）
POSTGRES_USER=jobfit
POSTGRES_PASSWORD=jobfit
POSTGRES_DB=jobfit

# 应用连接串（生产必须使用环境/密钥管理注入，禁止提交真实凭证）
DATABASE_URL=postgresql+psycopg://jobfit:jobfit@localhost:5432/jobfit
# 集成测试/E2E 专用库（与开发库隔离；可安全 TRUNCATE / reset）
TEST_DATABASE_URL=postgresql+psycopg://jobfit:jobfit@localhost:5432/jobfit_test

# ------------------------------------------------------------- 版本
# 部署时注入的流水线版本（写入 analyses.pipeline_version；应用版本见 pyproject.toml）
PIPELINE_VERSION=dev

# ------------------------------------------------------------- LLM（可选）
# Provider Protocol 选择键（当前仅 deepseek）
LLM_PROVIDER=deepseek
# 留空/不设置 => EXTERNAL CREDENTIAL BLOCKED（不伪造 live 结果）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------- Embedding（检索）
# MVP 基线为本地确定性 hash embedding；语义模型（bge-m3）属 V1（ADR-006/ADR-030）
EMBEDDING_MODEL=hash-ngram-v1

# ------------------------------------------------------------- CORS / 前端
# 逗号分隔的显式白名单；禁止使用 "*"。生产填写真实前端 origin。
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 前端侧变量（放在 frontend/.env.local；浏览器可见，禁止放任何密钥）
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------- 上传/资源上限
MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------- Retry budget（统一上限，ADR-018）
MAX_LLM_ATTEMPTS=15
MAX_PROVIDER_RETRIES=3
MAX_REPAIR_RETRIES=1
MAX_NODE_RETRIES=2

# ------------------------------------------------------------- 日志
LOG_LEVEL=INFO

# ------------------------------------------------------------- Worker lease（秒）
LEASE_TTL_SECONDS=120

# ------------------------------------------------------------- 路径
STORAGE_DIR=./data/uploads
CONFIG_DIR=./config

# ------------------------------------------------------------- PII 加密（留空 => 明文 + 哈希索引；生产必须设置）
PII_ENC_KEY=
